{
  "name": "cmsaas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Console administrativo web do CMSaaS (Church Management SaaS)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
